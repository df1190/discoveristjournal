DirectoryIndex index.html

RewriteEngine On

# Redirect old moto-* URLs to new clean paths
Redirect 301 /moto/moto-ktm-rally /moto/ktm-rally
Redirect 301 /moto/moto-ktm-bosnia /moto/ktm-bosnia
Redirect 301 /moto/moto-ktm-france /moto/ktm-france
Redirect 301 /moto/moto-ktm-norway /moto/ktm-norway
Redirect 301 /moto/moto-ktm-romania /moto/ktm-romania
Redirect 301 /moto/moto-ktm-italy /moto/ktm-italy
Redirect 301 /moto/moto-alpine-passes /moto/alpine-passes
Redirect 301 /moto/moto-tools /moto/tools

# Remove .html extension — serve /journeys as journeys.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect /page.html → /page (301 permanent, avoids duplicate content)
# But NOT index.html files — those serve as directory indexes (e.g. /blog/ not /blog/index)
RewriteCond %{THE_REQUEST} !/index\.html [NC]
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# Default charset + MIME types
AddDefaultCharset UTF-8
AddType text/html .html

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
